generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Node {
  id           String         @id @default(uuid())
  title        String
  content      String         @db.Text
  type         NodeType
  pineconeId   String         @unique 
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sourceId     String?        // Like messageId or URL

  sourceRelations NodeRelation[] @relation("sourceNode")
  targetRelations NodeRelation[] @relation("targetNode")
  tags            Tag[]
}

model NodeRelation {
  id           String       @id @default(uuid())
  sourceNodeId String
  targetNodeId String
  relationType RelationType 
  
  source       Node         @relation("sourceNode", fields: [sourceNodeId], references: [id])
  target       Node         @relation("targetNode", fields: [targetNodeId], references: [id])

  createdAt    DateTime     @default(now())

  @@index([sourceNodeId])
  @@index([targetNodeId])
}

model Conversation {
  id           String       @id @default(uuid())
  platform     String       // e.g. "facebook", "whatsapp", "internal"
  type         ChatType     // "business" | "personal"
  participants Json         // Array of user/contact names or IDs
  metadata     Json?        // Additional platform-specific data
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  messages     Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  sender         String       // Identifier of the sender
  text           String       @db.Text
  timestamp      DateTime
  metadata       Json?
  
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
}

model Agent {
  id           String   @id @default(uuid())
  name         String
  role         String
  systemPrompt String   @db.Text
  apiKey       String?  @db.VarChar(255) // Encrypted maybe
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VaultSecret {
  id           String   @id @default(uuid())
  keyName      String   @unique
  encryptedVal String   @db.Text // Encrypted with Master Password via AES E2EE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Tag {
  id     String @id @default(uuid())
  name   String @unique
  color  String? @default("#4f46e5")
  icon   String? @default("Tag")
  nodes  Node[]
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String   @default("INFO") // INFO, WARN, ERROR, SUCCESS
  message   String   @db.Text
  module    String?  // e.g. "Ingest", "Swarm", "Auth"
  metadata  Json?
  createdAt DateTime @default(now())
}

model ProcessingTask {
  id          String   @id @default(uuid())
  name        String
  status      String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  progress    Int      @default(0)
  totalChunks Int      @default(0)
  errorMessage String? @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum NodeType {
  DOCUMENT
  NOTE
  CODE
  AGENT_THOUGHT
}

enum RelationType {
  REFERENCES
  PARENT_OF
  SIMILAR_TO
}

enum ChatType {
  BUSINESS
  PERSONAL
}
